# Runtime
NODE_ENV=development

# HTTP server
API_PORT=3001

# Comma-separated list of origins allowed by CORS (no wildcards in prod)
CORS_ORIGINS=http://localhost:3000

# Postgres (locally — docker-compose service `postgres`)
DATABASE_URL=postgresql://sub0:sub0@localhost:5432/sub0

# JWT RS256 key-pair (ctx-security.md §2/§8). Generate locally:
#   openssl genpkey -algorithm RSA -pkcs8 -out jwt.key -pkeyopt rsa_keygen_bits:2048
#   openssl pkey -in jwt.key -pubout -out jwt.pub
# Paste PEM as a single line with literal \n between lines (server un-escapes).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=7776000
# false only for local HTTP dev; MUST be true in prod
COOKIE_SECURE=false

# SMTP (locally — docker-compose service `mailhog`; UI: http://localhost:8025)
# Prod: подставить креды выбранного RU/СНГ-провайдера
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Sub0 <noreply@sub0.local>"
# Base URL для ссылок в письмах (APP_BASE_URL + context.verifyPath)
APP_BASE_URL=http://localhost:3000
# Через сколько дней чистить отправленные строки mail_outbox
MAIL_RETENTION_DAYS=30

# Telegram (ctx-security.md §7). Connect deep-link базы (#45):
TELEGRAM_BOT_USERNAME=sub0_bot
# MAX deep-link база (опционально; без неё deep-link для MAX не отдаём)
MAX_BOT_URL_BASE=
# Bot webhook (#110): bot-токен для Bot API (sendMessage при verify) и
# secret для проверки заголовка X-Telegram-Bot-Api-Secret-Token. Без
# токена клиент no-op; без секрета webhook fail-closed (отвергает всё).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
