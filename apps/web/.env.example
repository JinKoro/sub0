# Base URL of the API (includes the /api/v1 global prefix)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# RS256 PUBLIC key — must match apps/api JWT_PUBLIC_KEY. Server-only (no
# NEXT_PUBLIC_ prefix): used by middleware to verify the sub0_session cookie.
# Single line, literal \n between PEM lines.
AUTH_JWT_PUBLIC_KEY=
